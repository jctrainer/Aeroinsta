 61.96, "e": 62.56}]}, {"start": 62.8, "end": 68.02, "text": " Joelho para dentro, é um dos padrões mais ligados a lesão de LCA e a dor na frente do joelho.", "words": [{"w": " Joelho", "s": 62.8, "e": 63.14}, {"w": " para", "s": 63.14, "e": 63.3}, {"w": " dentro,", "s": 63.3, "e": 63.66}, {"w": " é", "s": 63.8, "e": 63.84}, {"w": " um", "s": 63.84, "e": 63.9}, {"w": " dos", "s": 63.9, "e": 63.98}, {"w": " padrões", "s": 63.98, "e": 64.4}, {"w": " mais", "s": 64.4, "e": 64.8}, {"w": " ligados", "s": 64.8, "e": 65.28}, {"w": " a", "s": 65.28, "e": 65.44}, {"w": " lesão", "s": 65.44, "e": 65.76}, {"w": " de", "s": 65.76, "e": 65.88}, {"w": " LCA", "s": 65.88, "e": 66.3}, {"w": " e", "s": 66.3, "e": 66.66}, {"w": " a", "s": 66.66, "e": 66.78}, {"w": " dor", "s": 66.78, "e": 66.98}, {"w": " na", "s": 66.98, "e": 67.12}, {"w": " frente", "s": 67.12, "e": 67.36}, {"w": " do", "s": 67.36, "e": 67.56}, {"w": " joelho.", "s": 67.56, "e": 68.02}]}, {"start": 68.3, "end": 73.32, "text": " Soma carga alta, joelho desalinhado e base instável, é receita para lesão.", "words": [{"w": " Soma", "s": 68.3, "e": 68.5}, {"w": " carga", "s": 68.5, "e": 68.84}, {"w": " alta,", "s": 68.84, "e": 69.32}, {"w": " joelho", "s": 69.62, "e": 69.96}, {"w": " desalinhado", "s": 69.96, "e": 70.68}, {"w": " e", "s": 70.68, "e": 70.94}, {"w": " base", "s": 70.94, "e": 71.22}, {"w": " instável,", "s": 71.22, "e": 71.84}, {"w": " é", "s": 72.14, "e": 72.2}, {"w": " receita", "s": 72.2, "e": 72.76}, {"w": " para", "s": 72.76, "e": 72.92}, {"w": " lesão.", "s": 72.92, "e": 73.32}]}, {"start": 73.58, "end": 78.4, "text": " Olha a diferença, do lado de cá como foi, do lado de lá como deveria ser.", "words": [{"w": " Olha", "s": 73.58, "e": 73.78}, {"w": " a", "s": 73.78, "e": 73.86}, {"w": " diferença,", "s": 73.86, "e": 74.12}, {"w": " do", "s": 74.7, "e": 74.82}, {"w": " lado", "s": 74.82, "e": 75.02}, {"w": " de", "s": 75.02, "e": 75.22}, {"w": " cá", "s": 75.22, "e": 75.46}, {"w": " como", "s": 75.46,