[{"start": 0.0, "end": 1.34, "text": " Vamos começar na voadora.", "words": [{"w": " Vamos", "s": 0.0, "e": 0.36}, {"w": " começar", "s": 0.36, "e": 0.66}, {"w": " na", "s": 0.66, "e": 0.82}, {"w": " voadora.", "s": 0.82, "e": 1.34}]}, {"start": 1.94, "end": 5.98, "text": " Agachamento búlgaro para quadrícipes ou para glúteos?", "words": [{"w": " Agachamento", "s": 1.94, "e": 2.66}, {"w": " búlgaro", "s": 2.66, "e": 3.66}, {"w": " para", "s": 3.66, "e": 4.0}, {"w": " quadrícipes", "s": 4.0, "e": 5.0}, {"w": " ou", "s": 5.0, "e": 5.32}, {"w": " para", "s": 5.32, "e": 5.44}, {"w": " glúteos?", "s": 5.44, "e": 5.98}]}, {"start": 6.18, "end": 7.04, "text": " Hoje eu vi um post.", "words": [{"w": " Hoje", "s": 6.18, "e": 6.36}, {"w": " eu", "s": 6.36, "e": 6.46}, {"w": " vi", "s": 6.46, "e": 6.52}, {"w": " um", "s": 6.52, "e": 6.68}, {"w": " post.", "s": 6.68, "e": 7.04}]}, {"start": 7.46, "end": 13.88, "text": " Um post de uma influenciadora que falava que agachamento búlgaro com tronco inclinado", "words": [{"w": " Um", "s": 7.46, "e": 7.64}, {"w": " post", "s": 7.64, "e": 8.2}, {"w": " de", "s": 8.2, "e": 8.42}, {"w": " uma", "s": 8.42, "e": 8.54}, {"w": " influenciadora", "s": 8.54, "e": 9.22}, {"w": " que", "s": 9.22, "e": 9.86}, {"w": " falava", "s": 9.86, "e": 10.22}, {"w": " que", "s": 10.22, "e": 10.38}, {"w": " agachamento", "s": 10.38, "e": 11.1}, {"w": " búlgaro", "s": 11.1, "e": 12.48}, {"w": " com", "s": 12.48, "e": 12.58}, {"w": " tronco", "s": 12.58, "e": 13.08}, {"w": " inclinado", "s": 13.08, "e": 13.88}]}, {"start": 13.88, "end": 15.96, "text": " é para glúteos e posteriores.", "words": [{"w": " é", "s": 13.88, "e": 14.36}, {"w": " para", "s": 14.36, "e": 14.46}, {"w": " glúteos", "s": 14.46, "e": 15.18}, {"w": " e", "s": 15.18, "e": 15.4}, {"w": " posteriores.", "s": 15.4, "e": 15.96}]}, {"start": 16.26, "end": 17.06, "text": " Sim, posteriores.", "words": [{"w": " Sim,", "s": 16.26, "e": 16.36}, {"w": " posteriores.", "s": 16.62, "e": 17.06}]}, {"start": 17.92, "end": 23.3, "text": " E agachamento búlgaro com tronco reto é para quadrícipes e reto femoral.", "words": [{"w": " E", "s": 17.92, "e": 18.14}, {"w": " agachamento", "s": 18.14, "e": 18.94}, {"w": " búlgaro", "s": 18.94, "e": 19.84}, {"w": " com", "s": 19.84, "e": 19.92}, {"w": " tronco", "s": 19.92, "e": 20.4}, {"w": " reto", "s": 20.4, "e": 21.18}, {"w": " é", "s": 21.18, "e": 21.6}, {"w": " para", "s": 21.6, "e": 21.68}, {"w": " quadrícipes", "s": 21.68, "e": 22.46}, {"w": " e", "s": 22.46, "e": 22.7}, {"w": " reto", "s": 22.7, "e": 22.92}, {"w": " femoral.", "s": 22.92, "e": 23.3}]}, {"start": 23.9, "end": 24.98, "text": " Sim, reto femoral.", "words": [{"w": " Sim,", "s": 23.9, "e": 24.08}, {"w": " reto", "s": 24.34, "e": 24.54}, {"w": " femoral.", "s": 24.54, "e": 24.98}]}, {"start": 24.98, "end": 33.16, "text": " Isso aqui não é axismo, é biomecânica, é física, é mecânica, mecânica, biomecânica.", "words": [{"w": " Isso", "s": 24.98, "e": 25.94}, {"w": " aqui", "s": 25.94, "e": 26.1}, {"w": " não", "s": 26.1, "e": 26.24}, {"w": " é", "s": 26.24, "e": 26.36}, {"w": " axismo,", "s": 26.36, "e": 26.84}, {"w": " é", "s": 27.62, "e": 27.62}, {"w": " biomecânica,", "s": 27.62, "e": 28.52}, {"w": " é", "s": 28.7, "e": 28.84}, {"w": " física,", "s": 28.84, "e": 29.22}, {"w": " é", "s": 29.72, "e": 29.78}, {"w": " mecânica,", "s": 29.78, "e": 30.76}, {"w": " mecânica,", "s": 31.06, "e": 32.06}, {"w": " biomecânica.", "s": 32.16, "e": 33.16}]}, {"start": 33.64, "end": 38.84, "text": " Nada contra a pessoa em si e sim só relatando fatos e argumentos.", "words": [{"w": " Nada", "s": 33.64, "e": 33.88}, {"w": " contra", "s": 33.88, "e": 34.22}, {"w": " a", "s": 34.22, "e": 34.68}, {"w": " pessoa", "s": 34.68, "e": 34.92}, {"w": " em", "s": 34.92, "e": 35.12}, {"w": " si", "s": 35.12, "e": 35.26}, {"w": " e", "s": 35.26, "e": 35.54}, {"w": " sim", "s": 35.54, "e": 35.88}, {"w": " só", "s": 35.88, "e": 36.34}, {"w": " relatando", "s": 36.34, "e": 37.04}, {"w": " fatos", "s": 37.04, "e": 37.98}, {"w": " e", "s": 37.98, "e": 38.24}, {"w": " argumentos.", "s": 38.24, "e": 38.84}]}, {"start": 39.32, "end": 42.84, "text": " Vamos lá, no movimento em si é um agachamento unilateral", "words": [{"w": " Vamos", "s": 39.32, "e": 39.5}, {"w": " lá,", "s": 39.5, "e": 39.72}, {"w": " no", "s": 39.94, "e": 40.08}, {"w": " movimento", "s": 40.08, "e": 40.38}, {"w": " em", "s": 40.38, "e": 40.7}, {"w": " si", "s": 40.7, "e": 40.9}, {"w": " é", "s": 40.9, "e": 41.36}, {"w": " um", "s": 41.36, "e": 41.46}, {"w": " agachamento", "s": 41.46, "e": 42.02}, {"w": " unilateral", "s": 42.02, "e": 42.84}]}, {"start": 42.84, "end": 47.1, "text": " que vai ser trabalhado tanto com o tronco inclinado ou com o tronco reto,", "words": [{"w": " que", "s": 42.84, "e": 43.46}, {"w": " vai", "s": 43.46, "e": 43.62}, {"w": " ser", "s": 43.62, "e": 43.82}, {"w": " trabalhado", "s": 43.82, "e": 44.56}, {"w": " tanto", "s": 44.56, "e": 44.98}, {"w": " com", "s": 44.98, "e": 45.26}, {"w": " o", "s": 45.26, "e": 45.36}, {"w": " tronco", "s": 45.36, "e": 45.54}, {"w": " inclinado", "s": 45.54, "e": 46.08}, {"w": " ou", "s": 46.08, "e": 46.34}, {"w": " com", "s": 46.34, "e": 46.46}, {"w": " o", "s": 46.46, "e": 46.56}, {"w": " tronco", "s": 46.56, "e": 46.74}, {"w": " reto,", "s": 46.74, "e": 47.1}]}, {"start": 47.32, "end": 48.98, "text": " o quadrícipes e o glúteo, ponto.", "words": [{"w": " o", "s": 47.32, "e": 47.32}, {"w": " quadrícipes", "s": 47.32, "e": 47.88}, {"w": " e", "s": 47.88, "e": 48.18}, {"w": " o", "s": 48.18, "e": 48.26}, {"w": " glúteo,", "s": 48.26, "e": 48.74}, {"w": " ponto.", "s": 48.82, "e": 48.98}]}, {"start": 49.62, "end": 52.04, "text": " Aí não tem discussão, vai ser trabalhado nos dois.", "words": [{"w": " Aí", "s": 49.62, "e": 49.8}, {"w": " não", "s": 49.8, "e": 50.08}, {"w": " tem", "s": 50.08, "e": 50.3}, {"w": " discussão,", "s": 50.3, "e": 50.78}, {"w": " vai", "s": 50.98, "e": 51.06}, {"w": " ser", "s": 51.06, "e": 51.18}, {"w": " trabalhado", "s": 51.18, "e": 51.64}, {"w": " nos", "s": 51.64, "e": 51.82}, {"w": " dois.", "s": 51.82, "e": 52.04}]}, {"start": 52.04, "end": 59.38, "text": " Quando se coloca com o tronco inclinado que vai pegar ou vai ter uma ação do glúteo e posteriores,", "words": [{"w": " Quando", "s": 52.04, "e": 52.72}, {"w": " se", "s": 52.72, "e": 52.86}, {"w": " coloca", "s": 52.86, "e": 53.14}, {"w": " com", "s": 53.14, "e": 53.4}, {"w": " o", "s": 53.4, "e": 53.5}, {"w": " tronco", "s": 53.5, "e": 53.68}, {"w": " inclinado", "s": 53.68, "e": 54.22}, {"w": " que", "s": 54.22, "e": 54.38}, {"w": " vai", "s": 54.38, "e": 54.5}, {"w": " pegar", "s": 54.5, "e": 54.94}, {"w": " ou", "s": 54.94, "e": 55.42}, {"w": " vai", "s": 55.42, "e": 55.7}, {"w": " ter", "s": 55.7, "e": 56.18}, {"w": " uma", "s": 56.18, "e": 56.46}, {"w": " ação", "s": 56.46, "e": 56.94}, {"w": " do", "s": 56.94, "e": 57.32}, {"w": " glúteo", "s": 57.32, "e": 57.82}, {"w": " e", "s": 57.82, "e": 58.28}, {"w": " posteriores,", "s": 58.28, "e": 59.38}]}, {"start": 59.78, "end": 64.52, "text": " o glúteo sim, ele vai ter um pouco mais de ênfase que ênfase, não quer dizer exclusividade.", "words": [{"w": " o", "s": 59.78, "e": 60.12}, {"w": " glúteo", "s": 60.12, "e": 60.5}, {"w": " sim,", "s": 60.5, "e": 60.74}, {"w": " ele", "s": 61.02, "e": 61.24}, {"w": " vai", "s": 61.24, "e": 61.38}, {"w": " ter", "s": 61.38, "e": 61.62}, {"w": " um", "s": 61.62, "e": 61.78}, {"w": " pouco", "s": 61.78, "e": 62.04}, {"w": " mais", "s": 62.04, "e": 62.28}, {"w": " de", "s": 62.28, "e": 62.44}, {"w": " ênfase", "s": 62.44, "e": 62.94}, {"w": " que", "s": 62.94, "e": 63.12}, {"w": " ênfase,", "s": 63.12, "e": 63.44}, {"w": " não", "s": 63.54, "e": 63.6}, {"w": " quer", "s": 63.6, "e": 63.74}, {"w": " dizer", "s": 63.74, "e": 63.9}, {"w": " exclusividade.", "s": 63.9, "e": 64.52}]}, {"start": 64.9, "end": 68.08, "text": " Não quer dizer que tem um botão que desliga o seu quadrícipes da jogada.", "words": [{"w": " Não", "s": 64.9, "e": 65.02}, {"w": " quer", "s": 65.02, "e": 65.12}, {"w": " dizer", "s": 65.12, "e": 65.22}, {"w": " que", "s": 65.22, "e": 65.32}, {"w": " tem", "s": 65.32, "e": 65.42}, {"w": " um", "s": 65.42, "e": 65.5}, {"w": " botão", "s": 65.5, "e": 65.86}, {"w": " que", "s": 65.86, "e": 66.0}, {"w": " desliga", "s": 66.0, "e": 66.32}, {"w": " o", "s": 66.32, "e": 66.5}, {"w": " seu", "s": 66.5, "e": 66.5}, {"w": " quadrícipes", "s": 66.5, "e": 67.02}, {"w": " da", "s": 67.02, "e": 67.38}, {"w": " jogada.", "s": 67.38, "e": 68.08}]}, {"start": 68.42, "end": 68.9, "text": " Não tem como.", "words": [{"w": " Não", "s": 68.42, "e": 68.5}, {"w": " tem", "s": 68.5, "e": 68.64}, {"w": " como.", "s": 68.64, "e": 68.9}]}, {"start": 69.2, "end": 70.52, "text": " O quadrícipe vai ter sendo trabalhado.", "words": [{"w": " O", "s": 69.2, "e": 69.28}, {"w": " quadrícipe", "s": 69.28, "e": 69.54}, {"w": " vai", "s": 69.54, "e": 69.72}, {"w": " ter", "s": 69.72, "e": 69.76}, {"w": " sendo", "s": 69.76, "e": 69.92}, {"w": " trabalhado.", "s": 69.92, "e": 70.52}]}, {"start": 70.9, "end": 73.92, "text": " Você tem uma ênfase, não que o outro é desligado.", "words": [{"w": " Você", "s": 70.9, "e": 71.04}, {"w": " tem", "s": 71.04, "e": 71.18}, {"w": " uma", "s": 71.18, "e": 71.38}, {"w": " ênfase,", "s": 71.38, "e": 72.24}, {"w": " não", "s": 72.36, "e": 72.8}, {"w": " que", "s": 72.8, "e": 73.14}, {"w": " o", "s": 73.14, "e": 73.24}, {"w": " outro", "s": 73.24, "e": 73.4}, {"w": " é", "s": 73.4, "e": 73.52}, {"w": " desligado.", "s": 73.52, "e": 73.92}]}, {"start": 74.6, "end": 76.78, "text": " E agora colocar o posterior, aí você me quebra.", "words": [{"w": " E", "s": 74.6, "e": 74.72}, {"w": " agora", "s": 74.72, "e": 74.88}, {"w": " colocar", "s": 74.88, "e": 75.18}, {"w": " o", "s": 75.18, "e": 75.3}, {"w": " posterior,", "s": 75.3, "e": 75.68}, {"w": " aí", "s": 75.96, "e": 76.1}, {"w": " você", "s": 76.1, "e": 76.3}, {"w": " me", "s": 76.3, "e": 76.4}, {"w": " quebra.", "s": 76.4, "e": 76.78}]}, {"start": 76.98, "end": 80.22, "text": " Você me quebra, porque o posterior ali ele é relevante.", "words": [{"w": " Você", "s": 76.98, "e": 77.12}, {"w": " me", "s": 77.12, "e": 77.22}, {"w": " quebra,", "s": 77.22, "e": 77.54}, {"w": " porque", "s": 77.62, "e": 77.78}, {"w": " o", "s": 77.78, "e": 77.92}, {"w": " posterior", "s": 77.92, "e": 78.3}, {"w": " ali", "s": 78.3, "e": 78.56}, {"w": " ele", "s": 78.56, "e": 79.0}, {"w": " é", "s": 79.0, "e": 79.64}, {"w": " relevante.", "s": 79.64, "e": 80.22}]}, {"start": 80.22, "end": 81.86, "text": " Ele não tem participação.", "words": [{"w": " Ele", "s": 80.22, "e": 80.6}, {"w": " não", "s": 80.6, "e": 81.16}, {"w": " tem", "s": 81.16, "e": 81.34}, {"w": " participação.", "s": 81.34, "e": 81.86}]}, {"start": 82.38, "end": 84.54, "text": " No máximo é um músculo estabilizador.", "words": [{"w": " No", "s": 82.38, "e": 82.6}, {"w": " máximo", "s": 82.6, "e": 83.22}, {"w": " é", "s": 83.22, "e": 83.62}, {"w": " um", "s": 83.62, "e": 83.7}, {"w": " músculo", "s": 83.7, "e": 83.92}, {"w": " estabilizador.", "s": 83.92, "e": 84.54}]}, {"start": 84.74, "end": 86.28, "text": " Ele vai estar estabilizando seu movimento.", "words": [{"w": " Ele", "s": 84.74, "e": 84.74}, {"w": " vai", "s": 84.74, "e": 84.86}, {"w": " estar", "s": 84.86, "e": 85.02}, {"w": " estabilizando", "s": 85.02, "e": 85.86}, {"w": " seu", "s": 85.86, "e": 86.02}, {"w": " movimento.", "s": 86.02, "e": 86.28}]}, {"start": 86.78, "end": 89.72, "text": " É como se você não tivesse o posterior e você cai-se para frente.", "words": [{"w": " É", "s": 86.78, "e": 86.86}, {"w": " como", "s": 86.86, "e": 87.04}, {"w": " se", "s": 87.04, "e": 87.2}, {"w": " você", "s": 87.2, "e": 87.44}, {"w": " não", "s": 87.44, "e": 87.54}, {"w": " tivesse", "s": 87.54, "e": 87.82}, {"w": " o", "s": 87.82, "e": 88.02}, {"w": " posterior", "s": 88.02, "e": 88.3}, {"w": " e", "s": 88.3, "e": 88.88}, {"w": " você", "s": 88.88, "e": 89.08}, {"w": " cai", "s": 89.08, "e": 89.22}, {"w": "-se", "s": 89.22, "e": 89.38}, {"w": " para", "s": 89.38, "e": 89.5}, {"w": " frente.", "s": 89.5, "e": 89.72}]}, {"start": 90.08, "end": 90.34, "text": " Isso.", "words": [{"w": " Isso.", "s": 90.08, "e": 90.34}]}, {"start": 90.8, "end": 94.72, "text": " Agora ele participar ou ter uma questão de hipertrofia é colocar.", "words": [{"w": " Agora", "s": 90.8, "e": 91.04}, {"w": " ele", "s": 91.04, "e": 91.36}, {"w": " participar", "s": 91.36, "e": 91.94}, {"w": " ou", "s": 91.94, "e": 92.38}, {"w": " ter", "s": 92.38, "e": 92.56}, {"w": " uma", "s": 92.56, "e": 92.86}, {"w": " questão", "s": 92.86, "e": 93.2}, {"w": " de", "s": 93.2, "e": 93.34}, {"w": " hipertrofia", "s": 93.34, "e": 93.86}, {"w": " é", "s": 93.86, "e": 94.56}, {"w": " colocar.", "s": 94.56, "e": 94.72}]}, {"start": 95.26, "end": 95.8, "text": " Aí você pode me colocar.", "words": [{"w": " Aí", "s": 95.26, "e": 95.34}, {"w": " você", "s": 95.34, "e": 95.42}, {"w": " pode", "s": 95.42, "e": 95.56}, {"w": " me", "s": 95.56, "e": 95.64}, {"w": " colocar.", "s": 95.64, "e": 95.8}]}, {"start": 96.08, "end": 99.16, "text": " Pô, J, eu sinto meu posterior queimar.", "words": [{"w": " Pô,", "s": 96.08, "e": 96.12}, {"w": " J,", "s": 96.98, "e": 97.04}, {"w": " eu", "s": 97.5, "e": 97.68}, {"w": " sinto", "s": 97.68, "e": 97.96}, {"w": " meu", "s": 97.96, "e": 98.22}, {"w": " posterior", "s": 98.22, "e": 98.64}, {"w": " queimar.", "s": 98.64, "e": 99.16}]}, {"start": 99.38, "end": 102.88, "text": " Eu sinto, então, ele tá crescendo, tá tendo hipertrofia.", "words": [{"w": " Eu", "s": 99.38, "e": 99.38}, {"w": " sinto,", "s": 99.38, "e": 99.64}, {"w": " então,", "s": 99.72, "e": 99.96}, {"w": " ele", "s": 100.02, "e": 100.18}, {"w": " tá", "s": 100.18, "e": 100.48}, {"w": " crescendo,", "s": 100.48, "e": 101.98}, {"w": " tá", "s": 102.14, "e": 102.16}, {"w": " tendo", "s": 102.16, "e": 102.34}, {"w": " hipertrofia.", "s": 102.34, "e": 102.88}]}, {"start": 103.32, "end": 103.48, "text": " Não.", "words": [{"w": " Não.", "s": 103.32, "e": 103.48}]}, {"start": 104.1, "end": 105.66, "text": " Meu caro gafanhoto, não.", "words": [{"w": " Meu", "s": 104.1, "e": 104.32}, {"w": " caro", "s": 104.32, "e": 104.7}, {"w": " gafanhoto,", "s": 104.7, "e": 105.3}, {"w": " não.", "s": 105.6, "e": 105.66}]}, {"start": 106.5, "end": 110.46, "text": " Ativação ou a sensação de queimamento não tem a ver com hipertrofia.", "words": [{"w": " Ativação", "s": 106.5, "e": 107.02}, {"w": " ou", "s": 107.02, "e": 107.46}, {"w": " a", "s": 107.46, "e": 107.64}, {"w": " sensação", "s": 107.64, "e": 108.08}, {"w": " de", "s": 108.08, "e": 108.22}, {"w": " queimamento", "s": 108.22, "e": 108.64}, {"w": " não", "s": 108.64, "e": 108.88}, {"w": " tem", "s": 108.88, "e": 109.26}, {"w": " a", "s": 109.26, "e": 109.52}, {"w": " ver", "s": 109.52, "e": 109.74}, {"w": " com", "s": 109.74, "e": 109.88}, {"w": " hipertrofia.", "s": 109.88, "e": 110.46}]}, {"start": 110.98, "end": 112.4, "text": " São coisas totalmente diferentes.", "words": [{"w": " São", "s": 110.98, "e": 111.24}, {"w": " coisas", "s": 111.24, "e": 111.52}, {"w": " totalmente", "s": 111.52, "e": 112.0}, {"w": " diferentes.", "s": 112.0, "e": 112.4}]}, {"start": 112.98, "end": 114.3, "text": " E agora vamos para outro ponto.", "words": [{"w": " E", "s": 112.98, "e": 113.0}, {"w": " agora", "s": 113.0, "e": 113.18}, {"w": " vamos", "s": 113.18, "e": 113.38}, {"w": " para", "s": 113.38, "e": 113.6}, {"w": " outro", "s": 113.6, "e": 113.88}, {"w": " ponto.", "s": 113.88, "e": 114.3}]}, {"start": 114.8, "end": 116.38, "text": " Tronco reto, quadrícipes.", "words": [{"w": " Tronco", "s": 114.8, "e": 115.04}, {"w": " reto,", "s": 115.04, "e": 115.44}, {"w": " quadrícipes.", "s": 115.7, "e": 116.38}]}, {"start": 116.68, "end": 117.28, "text": " Vamos de novo.", "words": [{"w": " Vamos", "s": 116.68, "e": 116.84}, {"w": " de", "s": 116.84, "e": 117.02}, {"w": " novo.", "s": 117.02, "e": 117.28}]}, {"start": 117.66, "end": 12